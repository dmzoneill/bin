#!/usr/bin/python3
"""Query a Pinecone index and print the matching source snippets."""

from pinecone import Pinecone

from binlib import (
    format_pinecone_matches,
    pinecone_argument_parser,
    query_pinecone_index,
    require_pinecone_client,
)


def main() -> None:
    """Search the cwd index and print match text."""
    client = require_pinecone_client(Pinecone)
    args = pinecone_argument_parser().parse_args()
    _provider, results = query_pinecone_index(client, args.pinecone_query, top_k=10)
    if results["matches"]:
        print("Top 5 results from Pinecone:")
        print(format_pinecone_matches(results))


main()
