#!/usr/bin/python3
"""Upload local Python files into a Pinecone index named after the cwd."""

import os

import openai
import pinecone
from pinecone import Pinecone, ServerlessSpec

from binlib import (
    exception_types,
    index_changed_python_files,
    load_json_cache,
    openai_client_errors,
    require_nonempty_text,
    save_json_cache,
)


def get_embeddings(text: str) -> list[float]:
    """Embed text with the current OpenAI client."""
    require_nonempty_text(text)
    client = openai.Client()
    response = client.embeddings.create(input=[text], model="text-embedding-ada-002")
    return response.data[0].embedding


def main() -> None:
    """Create the index when needed, upload changed files, and run a sample query."""
    api_key = os.getenv("PINECONE_API_KEY")
    if not api_key:
        raise ValueError("PINECONE_API_KEY environment variable is not set.")

    pc_client = Pinecone(api_key=api_key)
    index_name = os.path.basename(os.getcwd()).replace("_", "-")
    print(f"Using index: {index_name}")

    if index_name not in pc_client.list_indexes().names():
        pc_client.create_index(
            name=index_name,
            dimension=1536,
            metric="euclidean",
            spec=ServerlessSpec(cloud="aws", region="us-east-1"),
        )

    cache_file = "pinecone-index.json"
    cache = load_json_cache(cache_file)
    codebase_dir = os.getcwd()
    print(f"Using codebase from: {codebase_dir}")
    index = pc_client.Index(index_name)
    pinecone_errors = getattr(pinecone, "exceptions", None)
    upload_errors = exception_types(
        *openai_client_errors(openai),
        getattr(pinecone_errors, "PineconeException", None),
    )

    def upload(file_path: str, code: str) -> None:
        embedding = get_embeddings(code)
        metadata = {"file": file_path, "text": code}
        index.upsert([(file_path, embedding, metadata)])

    index_changed_python_files(codebase_dir, cache, upload, upload_errors)
    save_json_cache(cache_file, cache)
    query_embedding = get_embeddings("list issues")
    result = index.query(vector=query_embedding, top_k=5, include_metadata=True)
    print(result)


main()
