#!/usr/bin/python3
"""Upload local Python files into a local Weaviate CodeSnippet class."""

import os

import openai
import weaviate

from binlib import (
    index_changed_python_files,
    load_json_cache,
    require_nonempty_text,
    save_json_cache,
)


def get_embeddings(text: str) -> list[float]:
    """Embed text with the legacy OpenAI embeddings endpoint."""
    require_nonempty_text(text)
    response = openai.Embedding.create(input=[text], model="text-embedding-ada-002")
    return response["data"][0]["embedding"]


def main() -> None:
    """Create the class when needed, upload changed files, and run a sample query."""
    client = weaviate.Client(os.getenv("WEAVIATE_URL", "http://localhost:8080"))
    schema = {
        "class": "CodeSnippet",
        "properties": [
            {"name": "code", "dataType": ["text"]},
            {"name": "vector", "dataType": ["number[]"]},
        ],
    }
    existing_classes = client.schema.get()["classes"]
    if not any(cls["class"] == "CodeSnippet" for cls in existing_classes):
        client.schema.create_class(schema)
        print("Created 'CodeSnippet' class in Weaviate.")

    openai.api_key = os.getenv("OPENAI_API_KEY")
    cache_file = "weaviate-cache.json"
    cache = load_json_cache(cache_file)
    codebase_dir = os.getcwd()
    print(f"Using codebase from: {codebase_dir}")

    def upload(_file_path: str, code: str) -> None:
        embedding = get_embeddings(code)
        data_object = {
            "code": code,
            "vector": embedding,
        }
        client.data_object.create(data_object, "CodeSnippet")

    index_changed_python_files(codebase_dir, cache, upload)
    save_json_cache(cache_file, cache)
    query_embedding = get_embeddings("list issues")
    result = (
        client.query.get("CodeSnippet", ["code"])
        .with_near_vector({"vector": query_embedding, "certainty": 0.8})
        .do()
    )
    print(result)


main()
