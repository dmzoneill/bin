#!/usr/bin/python3
"""Query Pinecone and ask OpenAI to turn the matches into Python code."""

import os
import re

from pinecone import Pinecone

from binlib import (
    RESPONSE_PARSE_ERRORS,
    OpenAIError,
    format_pinecone_matches,
    pinecone_argument_parser,
    query_pinecone_index,
    require_pinecone_client,
)


def main() -> None:
    """Search the cwd index and optionally write the generated file."""
    client = require_pinecone_client(Pinecone)
    parser = pinecone_argument_parser()
    parser.add_argument(
        "openai_question",
        type=str,
        help="The question to ask OpenAI about the Pinecone matches.",
    )
    parser.add_argument(
        "--dontwrite",
        action="store_true",
        help="Disable writing the generated code to files.",
    )
    args = parser.parse_args()
    provider, results = query_pinecone_index(client, args.pinecone_query, top_k=5)
    if results["matches"]:
        print("Top 10 results from Pinecone:")
        matches_with_info = format_pinecone_matches(results)
        _write_generated_code(provider, matches_with_info, args)
    else:
        print("No matches found in the Pinecone index.")


def _write_generated_code(provider, matches_with_info: str, args) -> None:
    """Ask OpenAI for code and save it unless ``--dontwrite`` is set."""
    try:
        prompt = "You are a professional python software engineer. You reply only with python code."
        prompt += "At the top of the code specify the full path and filename."
        prompt += (
            "Put something unique about the name in the filename if creating new files."
        )
        prompt += "E.g: # File: /path/to/file"
        summary = provider.ask(
            model="gpt-3.5-turbo",
            system=prompt,
            user=matches_with_info + "\n\n" + args.openai_question,
        )
        print("\nOpenAI Summary/Response:")
        print(summary)
        code_match = re.search(r"# File: (.+?)\n([\s\S]*)", summary)
        if code_match:
            file_path = code_match.group(1)
            code = code_match.group(2)
            code = code.rstrip("```").strip()
            if not args.dontwrite and os.path.exists(file_path):
                raise FileExistsError(f"File already exists at: {file_path}")
            if not args.dontwrite:
                with open(file_path, "w", encoding="utf-8") as handle:
                    handle.write(code)
                print(f"Code saved to {file_path}")
            else:
                print("Writing to file is disabled. Code generation complete.")
        else:
            print("No valid code block found in the response.")
    except (OSError, OpenAIError) + RESPONSE_PARSE_ERRORS as exc:
        print(f"Error during OpenAI request: {str(exc)}")


main()
