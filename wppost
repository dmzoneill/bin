def determine_languages_from_files(files: List[str]) -> List[str]:
    """
    Determine the programming languages used in the provided files based on their extensions.

    :param files: List of file paths
    :return: List of unique programming languages
    """
    languages: set[str] = set()
    for file_path in files:
        _, ext = os.path.splitext(file_path)
        if ext in EXTENSION_LANGUAGE_MAP:
            languages.add(EXTENSION_LANGUAGE_MAP[ext])
    return list(languages)


def get_publish_date() -> str:
    """
    Get the current date and time in ISO 8601 format for the publish date.

    :return: String representing the current date and time in ISO 8601 format
    """
    return datetime.datetime.now().strftime("%Y-%m-%dT%H:%M:%S")


def clean_html_code_block(content: str) -> str:
    """
    Remove code block delimiters from the given content.

    Arguments:
    - content (str): A string containing HTML code block delimiters.

    Return:
    - str: The content with the start and end of code block delimiters removed.
    """
    # Remove start of code block
    content = re.sub(r"^```.*?$", "", content, flags=re.MULTILINE)
    content = re.sub(r"```$", "", content)  # Remove end of code block
    return content


def strip_html_tags(text: str) -> str:
    """
    Remove HTML tags from the input text.

    Arguments:
    - text (str): A string containing HTML tags that need to be stripped.

    Return:
    - str: The input text with all HTML tags removed.
    """
    return re.sub(r"<[^>]*>", "", text)


def generate_description(prompt: str) -> Tuple[Optional[str], Optional[str]]:
    """
    Generate a blog post description based on a provided source code prompt.

    Arguments:
    - prompt (str): The source code prompt to generate a blog post from.

    Return:
    - tuple: A tuple containing the title and description of the generated blog post.
    Returns (None, None) if an error occurs during the generation process.
    """
    user_prompt: str = prompt
    ai_provider = wordpress_openai()

    try:
        response: str = ai_provider.improve_text(SYSTEM_PROMPT, user_prompt)

        print(SYSTEM_PROMPT)
        print(response)

        title_match: Optional[re.Match] = re.search(
            r"Title:\s*(.*)", response
        )  # Match the title
        if title_match:
            title: str = title_match.group(1).strip()
            description: str = re.sub(r"Title:\s*.*\n", "", response).strip()
            return title, description
        title = clean_html_code_block(response.strip()).strip().splitlines()[0]
        return strip_html_tags(title), response.strip()

    except (requests.exceptions.RequestException,) + RESPONSE_PARSE_ERRORS as exc:
        print(f"Error generating description: {exc}")
        return None, None


def get_or_create_tags(tags: List[str]) -> List[int]:
    """
    Retrieve existing tag IDs from a WordPress site or create new tags if they do not exist.

    Arguments:
    - tags (list): A list of strings representing the names of tags to retrieve or create.

    Return:
    - list: A list of integers containing the IDs of the existing or newly created tags.
    """
    tag_ids: List[int] = []
    tags_url: str = f"{WORDPRESS_URL}tags"
    headers: Dict[str, str] = {
        "Content-Type": "application/json",
        "Authorization": "Basic "
        + base64.b64encode(
            f"{WORDPRESS_USERNAME}:{WORDPRESS_APPLICATION}".encode()
        ).decode(),
    }

    response: requests.Response = requests.get(
        tags_url, headers=headers, params={"page": 1, "per_page": 100}, timeout=30
    )
    if response.status_code == 200:
        existing_tags: List[Dict[str, Any]] = response.json()
        existing_tag_names: Dict[str, int] = {
            tag["name"].lower(): tag["id"] for tag in existing_tags
        }

        for tag in tags:
            tag_lower: str = tag.lower()
            if tag_lower in existing_tag_names:
                tag_ids.append(existing_tag_names[tag_lower])
            else:
                create_tag_url: str = f"{WORDPRESS_URL}tags"
                create_tag_data: Dict[str, str] = {"name": tag}
                create_response: requests.Response = requests.post(
                    create_tag_url, json=create_tag_data, headers=headers, timeout=30
                )
                if create_response.status_code == 201:
                    new_tag: Dict[str, int] = create_response.json()
                    tag_ids.append(new_tag["id"])
                else:
                    print(f"Failed to create tag '{tag}'.")
    else:
        print(f"Failed to fetch tags. Status code: {response.status_code}")

    return tag_ids


def get_category_id(languages: List[str], categories: List[Dict[str, Any]]) -> int:
    """
    Get the category ID based on the provided programming languages and categories.

    Arguments:
    - languages (list): A list of programming languages to search for.
    - categories (list): A list of dictionaries representing categories with "name" and "id" keys.

    Return:
    - int: The ID of the category that matches any of the provided programming languages.
    """
    category_id: int = 0

    # Loop through each category and check if any category name matches the
    # programming languages
    for category in categories:
        for language in languages:
            if language.lower() == category["name"].lower():
                category_id = category["id"]
                break

    return category_id


def _splice_source_files(clean_content: str, files: List[str]) -> str:
    """Replace ``# File:`` placeholders with the text of each source file."""
    for file_path in files:
        try:
            with open(file_path, "r", encoding="utf-8") as handle:
                file_content = handle.read()
            search = f"# File: {os.path.basename(file_path)}"
            clean_content = clean_content.replace(search, "\n" + file_content + "\n")
        except FILE_READ_ERRORS as exc:
            print(f"Error reading file {file_path}: {exc}")
    return clean_content


def generate_description_with_media(
    prompt: str,
) -> Tuple[Optional[str], Optional[str], Optional[str], Optional[List[str]]]:
    """Return a title, HTML body, image idea, and YouTube topics."""
    ai_provider = wordpress_openai()

    response = ai_provider.improve_text(SYSTEM_PROMPT, prompt)

    # Use regex to extract image_idea and youtube_topics
    image_match = re.search(r"<p>image_idea:\s*(.*?)</p>$", response, re.MULTILINE)
    youtube_match = re.search(
        r"<p>youtube_topics:\s*(.*?)</p>$", response, re.MULTILINE
    )

    image_idea = None
    youtube_topics = []

    print("=== generate_description_with_media ===")
    print(response)

    # Extract image_idea if match is found
    if image_match:
        image_idea = image_match.group(1).strip()
    else:
        print("No image_idea found in the response.")

    # Extract youtube_topics if match is found
    if youtube_match:
        youtube_topics_raw = youtube_match.group(1).strip()
        youtube_topics = [topic.strip() for topic in youtube_topics_raw.split(",")]
    else:
        print("No youtube_topics found in the response.")

    # Remove the media-related lines from the response to get the content
    if image_match:
        response = response[: image_match.start()].strip()

    # Extract the title from the response
    title_match = re.search(r"Title:\s*(.*)", response)
    if title_match:
        title = title_match.group(1).strip()
        content = re.sub(r"Title:\s*.*\n", "", response).strip()
        return title, content, image_idea, youtube_topics

    return None, response, image_idea, youtube_topics


def create_wordpress_post(
    title: str,
    content: str,
    excerpt: str,
    files: List[str],
    featured_image_url: Optional[str] = None,
) -> Optional[Dict]:
    """
    Creates a WordPress post with the provided title, content, excerpt, and files.

    Arguments:
    - title (str): The title of the WordPress post.
    - content (str): The content of the WordPress post.
    - excerpt (str): The excerpt of the WordPress post.
    - files (list): List of files to determine programming languages.

    Return:
    - dict or None: A dictionary containing the response data if the post is successfully created,
    otherwise None.

    Exceptions:
    - requests.exceptions.RequestException: If an error occurs during the HTTP request.
    """
    # pylint: disable=too-many-locals
    url: str = f"{WORDPRESS_URL}posts"
    raw_creds = f"{WORDPRESS_USERNAME}:{WORDPRESS_APPLICATION}".encode()
    creds = base64.b64encode(raw_creds).decode("utf-8")
    headers: Dict[str, str] = {
        "Content-Type": "application/json",
        "Authorization": f"Basic {creds}",
    }

    # Determine languages from the provided files
    languages: List[str] = determine_languages_from_files(files)
    if not languages:
        print("No programming languages detected in the provided files.")
        return None

    # Get tags and categories
    tag_ids: List[int] = get_or_create_tags(languages)
    categories_url: str = f"{WORDPRESS_URL}categories"
    response: requests.Response = requests.get(
        categories_url, headers=headers, params={"page": 1, "per_page": 100}, timeout=30
    )
    category_id: int = 0
    if response.status_code == 200:
        categories: List[Dict[str, Any]] = response.json()
        category_id = get_category_id(languages, categories)

        if not category_id:
            print("No matching categories found. Using default category.")

    # Clean and prepare content
    clean_content = _splice_source_files(clean_html_code_block(content), files)

    title = strip_html_tags(clean_html_code_block(title))
    excerpt = strip_html_tags(clean_html_code_block(excerpt))

    # Get the current publish date
    publish_date: str = get_publish_date()

    post_data: Dict[str, Any] = {
        "title": title,
        "content": clean_content,
        "status": "publish",
        "date": publish_date,
        "excerpt": excerpt,
        "slug": title.replace(" ", "-").lower(),
        "tags": tag_ids,
        "categories": category_id,
    }

    # If a featured image URL is provided, upload it and set it as the featured image
    if featured_image_url:
        try:
            img_data = requests.get(featured_image_url).content
            media_url = f"{WORDPRESS_URL}media"
            media_headers = {
                "Content-Disposition": f"attachment; filename={title}.jpg",
                "Content-Type": "image/jpeg",
                "Authorization": f"Basic {creds}",
            }
            media_response = requests.post(
                media_url, headers=media_headers, data=img_data
            )
            if media_response.status_code == 201:
                media_id = media_response.json().get("id")
                if media_id:
                    post_data["featured_media"] = media_id
                    post_data["content"] = post_data["content"].replace(
                        "FEATURED_IMAGE_PLACEHOLDER",
                        media_response.json().get("source_url"),
                    )
            else:
                detail = f"{media_response.status_code} - {media_response.text}"
                print(f"Failed to upload featured image: {detail}")
        except (requests.exceptions.RequestException,) + RESPONSE_PARSE_ERRORS as exc:
            print(f"Error uploading featured image: {exc}")

    try:
        created: requests.Response = requests.post(
            url, json=post_data, headers=headers, timeout=30
        )
        if created.status_code == 201:
            print(f"Post created successfully! URL: {created.json()['link']}")
            return created.json()
        print(f"Failed to create post. Status Code: {created.status_code}")
        return None

    except requests.exceptions.RequestException as e:
        print(f"Request failed: {str(e)}")
        return None


def generate_blog_post_prompt(
    files: List[str], optional_input: Optional[str] = None
) -> str:
    """
    Generate a blog post prompt based on the content of the provided files and optional input.

    Arguments:
    - files (list): A list of file paths containing the source code for the blog post.
    - optional_input (str, optional): Additional input to be included in the prompt. Defaults to
    None.

    Return:
    - str: A formatted prompt for generating a blog post, including the content of the files and
    optional input.

    The function reads the content of each file in the provided list of file paths, adds the file
    name and content to
    the prompt, and formats the prompt for generating a blog post. If an optional input is
    provided, it is included in
    the prompt as well. The function also handles exceptions that may occur while reading files.

    Side Effects:
    - May print error messages if there are issues reading files.
    """
    prompt: str = "Generate a blog post from the below source code:\n\n"

    for file_path in files:
        try:
            # Read the content of the file
            with open(file_path, "r", encoding="utf-8") as file:
                content: str = file.read()

            # Add the file name and content to the prompt
            prompt += f"File: {os.path.basename(file_path)}\n"
            prompt += f"Content:\n{content}\n\n"
        except FILE_READ_ERRORS as exc:
            print(f"Error reading file {file_path}: {exc}")
            continue

    prompt += "The content should be formatted in HTML for WordPress, not markdown.\n"

    if optional_input:
        prompt += f"\n\n{optional_input}\n"

    return prompt


def get_files_from_path(file_or_folder_path: str) -> List[str]:
    """
    Create an array of file paths from the given path.
    If it's a file, return an array with a single entry.
    If it's a directory, return an array of file paths recursively.

    :param file_or_folder_path: Path to a file or directory
    :return: List of file paths
    :raises ValueError: If the provided path is neither a file nor a directory
    """
    if os.path.isfile(file_or_folder_path):
        # If it's a file, return a list with a single entry
        return [file_or_folder_path]

    if os.path.isdir(file_or_folder_path):
        # If it's a directory, walk through it recursively and collect file
        # paths
        file_paths: List[str] = []
        for root, _, files in os.walk(file_or_folder_path):
            for file in files:
                file_paths.append(os.path.join(root, file))
        return file_paths

    print(f"The path '{file_or_folder_path}' is neither a file nor a directory.")
    sys.exit(1)


def parse_arguments() -> argparse.Namespace:
    """
    Parse command-line arguments for the script.

    Arguments:
    - No arguments needed.

    Return:
    - Returns the parsed command-line arguments as an argparse Namespace object.
    """
    parser: argparse.ArgumentParser = argparse.ArgumentParser(
        description="Process a file or directory and an optional input string."
    )
    parser.add_argument("path", type=str, help="Path to a file or directory.")
    parser.add_argument(
        "--input", type=str, help="Optional input string.", default=None
    )
    return parser.parse_args()


def _enrich_with_media(title, description, image_idea, youtube_topics):
    """Attach an Unsplash image URL and a YouTube embed to the post body."""
    unsplash_key = os.getenv("UNSPLASH_ACCESS_KEY")
    youtube_key = os.getenv("YOUTUBE_API")
    image_url = None
    if image_idea and unsplash_key:
        raw_img_url = search_image_url_unsplash(image_idea, unsplash_key)
        if raw_img_url:
            image_url = upload_image_to_wordpress(
                raw_img_url,
                title + ".jpg",
                f"{WORDPRESS_URL}media",
                WORDPRESS_USERNAME,
                WORDPRESS_APPLICATION,
            )
    video_url = None
    if youtube_topics and youtube_key:
        for topic in youtube_topics:
            video_url = search_youtube_video(topic, youtube_key)
            if video_url:
                break
    return append_enrichment_to_post(description, video_url), image_url


def main() -> None:
    """
    This function serves as the main entry point for processing a file or directory path,
    generating a blog post
    prompt, utilizing OpenAI to generate a title and description, preparing an SEO excerpt, and
    creating a WordPress
    post based on the processed data.

    Arguments:
    - No arguments are passed directly to the function. However, the function relies on the
    following components:
    - Command-line arguments obtained by parsing arguments using 'parse_arguments()'.
    - 'file_or_dir_path': Represents the path (file or directory) obtained from the parsed
    arguments.
    - 'optional_input': Represents an optional input string obtained from the parsed arguments.
    - 'files': A list of files obtained from the path using 'get_files_from_path()'.
    - 'prompt': A blog post prompt generated based on the files and optional input.
    - 'title': The title of the blog post generated using OpenAI.
    - 'description': The description of the blog post generated using OpenAI.
    - 'excerpt': The SEO excerpt derived from the description.
    - 'post_response': Response from creating a WordPress post using 'create_wordpress_post()'.

    Return:
    - No explicit return value. The function prints out various processing steps and outcomes.

    Exceptions:
    - Any exceptions raised during the main processing are caught and printed with a generic error
    message.

    Side Effects:
    - The function interacts with external services for generating blog content and creating a
    WordPress post.
    - It prints out information related to the processing steps and outcomes.
    """
    # Parse command-line arguments
    args: argparse.Namespace = parse_arguments()
    file_or_dir_path: str = args.path
    optional_input: Optional[str] = args.input

    print(f"Processing path: {file_or_dir_path}")
    if optional_input:
        print(f"Optional input string: {optional_input}")

    files: List[str] = get_files_from_path(file_or_dir_path)

    prompt: str = generate_blog_post_prompt(files, optional_input)

    # Generate description using OpenAI
    title: Optional[str]
    description: Optional[str]
    image_idea: Optional[str]
    youtube_topics: Optional[List[str]]

    # Generate content with media
    title, description, image_idea, youtube_topics = generate_description_with_media(
        prompt
    )

    print(title)
    print(image_idea)
    print(youtube_topics)

    if not title or not description:
        print("Error generating title/description.")
        sys.exit(1)

    # Prepare the SEO excerpt
    excerpt: str = strip_html_tags(clean_html_code_block(description)).strip()
    # Use the first 150 characters as an SEO excerpt
    excerpt = excerpt[:150].strip()
    description, image_url = _enrich_with_media(
        title, description, image_idea, youtube_topics
    )

    # Create WordPress post
    post_response: Optional[Dict] = create_wordpress_post(
        title, description, excerpt, files, featured_image_url=image_url
    )
    if post_response:
        print("Created post")
    else:
        print("Failed to create post")


if __name__ == "__main__":
    main()
